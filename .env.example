# Server Node, non GitHub Pages. Copiare in .env e configurare solo sul server.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# In produzione obbligatorio: URL pubblico HTTPS, senza slash finale.
APP_ORIGIN=http://localhost:3000
# Password amministrativa di almeno 12 caratteri. Non inserirla in chat o in Git.
ADMIN_PASSWORD=
# Chiave e modello di un account OpenAI con Responses, web_search e Structured Outputs.
# Nessuna chiamata o ricerca viene simulata se la configurazione manca.
OPENAI_API_KEY=
OPENAI_MODEL=
DAILY_AI_LIMIT=10
# Solo anteprima locale senza informazioni riservate. Blocca SEMPRE le chiamate IA.
DEV_AUTH_BYPASS=false
