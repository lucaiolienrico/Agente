# Server Node, non GitHub Pages. Copiare in .env e configurare solo sul server.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# In produzione obbligatorio: URL pubblico HTTPS, senza slash finale.
APP_ORIGIN=http://localhost:3000
# Password amministrativa di almeno 12 caratteri. Non inserirla in chat o in Git.
ADMIN_PASSWORD=
# Provider predefinito: Groq. Nessun fallback automatico a OpenAI.
AI_PROVIDER=groq
# Configura la chiave soltanto sul server/Codespace, mai in chat o nel repository.
GROQ_API_KEY=
# Modello open-weight eseguito da Groq: NON è l'API ChatGPT/OpenAI.
GROQ_MODEL=openai/gpt-oss-20b
# Ricerca opzionale con groq/compound-mini (1 tool call): verifica quote e costi.
GROQ_SEARCH_ENABLED=false
# Alternativa solo esplicita: AI_PROVIDER=openai. Ignorata quando si usa Groq.
OPENAI_API_KEY=
OPENAI_MODEL=
DAILY_AI_LIMIT=10
# Solo anteprima locale senza informazioni riservate. Blocca SEMPRE le chiamate IA.
DEV_AUTH_BYPASS=false
