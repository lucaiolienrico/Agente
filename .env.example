# Server Node, non GitHub Pages. Copiare in .env e configurare solo sul server.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
# In produzione obbligatorio: URL pubblico HTTPS, senza slash finale.
APP_ORIGIN=http://localhost:3000
# Password amministrativa di almeno 12 caratteri. Non inserirla in chat o in Git.
ADMIN_PASSWORD=
# Provider predefinito: Groq. Nessun fallback automatico a OpenAI.
AI_PROVIDER=groq
# Configura la chiave soltanto sul server/Codespace, mai in chat o nel repository.
GROQ_API_KEY=
# Modello open-weight eseguito da Groq: NON è l'API ChatGPT/OpenAI.
GROQ_MODEL=openai/gpt-oss-20b
# Ricerca opzionale con groq/compound-mini (1 tool call): verifica quote e costi.
GROQ_SEARCH_ENABLED=false
# Alternativa solo esplicita: AI_PROVIDER=openai. Ignorata quando si usa Groq.
OPENAI_API_KEY=
OPENAI_MODEL=
DAILY_AI_LIMIT=10

# --- Contatti multicanale (email Resend + WhatsApp Business API) ---
# DISATTIVATI per impostazione predefinita. Nessun invio esterno senza OUTREACH_ENABLED=true.
# Richiedono un server protetto: non ammessi con DEV_AUTH_BYPASS=true né in anteprima.
OUTREACH_ENABLED=false
# Limite invii per giorno UTC (1-100). Orario lavorativo lun-ven 9-18 Europe/Rome sempre attivo.
OUTREACH_DAILY_LIMIT=20
OUTREACH_BUSINESS_HOURS=true
# Email tramite Resend. Webhook obbligatorio per ricevere risposte ed esiti di consegna.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Segreto webhook Resend (>= 16 caratteri). Solo sul server, mai in chat o in Git.
RESEND_WEBHOOK_SECRET=
# WhatsApp Business tramite API Cloud Meta (numero dedicato, template approvati).
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_GRAPH_VERSION=v23.0
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Solo anteprima locale senza informazioni riservate. Blocca SEMPRE le chiamate IA e gli invii.
DEV_AUTH_BYPASS=false
